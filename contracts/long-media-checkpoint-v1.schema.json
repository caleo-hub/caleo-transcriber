{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caleo.local/contracts/long-media-checkpoint-v1.schema.json",
  "title": "LongMediaCheckpointV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "source_fingerprint",
    "parameters_hash",
    "created_at",
    "expires_at",
    "chunks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "source_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parameters_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chunk" }
    }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "state", "attempts", "result_ref"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["pending", "uploading", "confirmed", "failed", "ambiguous"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "result_ref": {
          "type": ["string", "null"],
          "pattern": "^chunk-[0-9]+\\.dpapi$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "confirmed" } } },
          "then": { "properties": { "result_ref": { "type": "string" } } },
          "else": { "properties": { "result_ref": { "type": "null" } } }
        }
      ]
    }
  }
}
